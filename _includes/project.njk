<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description }}">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/projects/project.css">
</head>

<body class="{{ bodyClass }}">

<header class="project-header">
  <div class="project-container project-header-inner">
    <a class="project-brand" href="{{ langPrefix }}index.html">Carolina Sánchez Girona</a>
    <nav class="project-nav" aria-label="Project navigation">
      <a href="{{ langPrefix }}projects.html">{{ nav.projects }}</a>
      <a href="{{ langPrefix }}index.html#contact">{{ nav.contact }}</a>
    </nav>
    <div class="language-link" aria-label="Language selector">
      {% if lang == 'es' %}
        <a href="/projects/{{ slug }}.html">EN</a>
        <span aria-hidden="true">/</span>
        <span class="current-language">ES</span>
      {% else %}
        <span class="current-language">EN</span>
        <span aria-hidden="true">/</span>
        <a href="/es/projects/{{ slug }}.html">ES</a>
      {% endif %}
    </div>
  </div>
</header>

<main>
{{ content | safe }}
</main>

<footer class="project-footer">
  <div class="project-container project-footer-inner">
    <p>© 2026 Carolina Sánchez Girona · {{ projectName }}</p>
    <a href="{{ langPrefix }}projects.html">{{ backLabel }}</a>
  </div>
</footer>

</body>
</html>