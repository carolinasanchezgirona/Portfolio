<!DOCTYPE html>
<html lang="{{ lang | default('en') }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{{ description }}">
  <title>{{ title }}</title>
  <link rel="stylesheet" href="/projects/project.css">
</head>

<body class="{{ bodyClass }}">

<header>
  <div class="container header-inner">
    <a class="brand" href="{{ langPrefix }}index.html">Carolina Sánchez Girona</a>
    <div class="language-link" aria-label="Language selector">
      {% if lang == 'es' %}
        <a href="/projects/{{ slug }}.html">EN</a>
        <span aria-hidden="true">/</span>
        <span class="current-language">ES</span>
      {% else %}
        <span class="current-language">EN</span>
        <span aria-hidden="true">/</span>
        <a href="/es/projects/{{ slug }}.html">ES</a>
      {% endif %}
    </div>
    <a class="back" href="{{ langPrefix }}projects.html">{{ backLabel }}</a>
  </div>
</header>

{{ content | safe }}

<footer>
  <div class="container footer-inner">
    <p>© 2026 Carolina Sánchez Girona</p>
    <a href="{{ langPrefix }}projects.html">{{ backLabel }}</a>
  </div>
</footer>

</body>
</html>